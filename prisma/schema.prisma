generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  CLINIC_MANAGER
  DOCTOR
  RECEPTIONIST
  NURSE
  ACCOUNTANT
  HR_OFFICER
  PHARMACIST
  LAB_TECHNICIAN
  RADIOLOGIST
  AUDITOR
}

enum Gender {
  MALE
  FEMALE
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  NO_SHOW
  CANCELLED
  RESCHEDULED
  URGENT
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  PROCEDURE
  LAB_VISIT
  IMAGING
  EMERGENCY
  DENTAL
  CHECKUP
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  INSURANCE
  BANK_TRANSFER
  MOBILE
}

enum POStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  MATERNITY
  PATERNITY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AssetStatus {
  ACTIVE
  UNDER_MAINTENANCE
  DISPOSED
  TRANSFERRED
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  DIFFERENTIAL
}

enum LabPriority {
  ROUTINE
  URGENT
  STAT
}

enum LabOrderStatus {
  PENDING_COLLECTION
  IN_PROGRESS
  RESULTS_READY
  RESULTS_RELEASED
  CANCELLED
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
  ALERT
}

// ─── USER & AUTHENTICATION ────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?
  nationalId   String?    @unique
  passwordHash String
  photo        String?
  roles        Json       @default("[]")
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  isActive     Boolean    @default(true)
  twoFAEnabled Boolean    @default(false)
  twoFASecret  String?
  lastLogin    DateTime?
  failedLogins Int        @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  doctor        Doctor?
  employee      Employee?
  auditLogs     AuditLog[]
  notifications Notification[]
  sessions      Session[]
  approvedExpenses Expense[] @relation("ExpenseApprover")
  recordedExpenses Expense[] @relation("ExpenseRecorder")
  recordedPayments Payment[]
  stockMovements   StockMovement[]

  @@map("users")
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String   @unique
  expiresAt     DateTime
  twoFAVerified Boolean  @default(false)
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@map("sessions")
}

// ─── DEPARTMENTS ──────────────────────────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String?  @unique
  parentId    String?
  parent      Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DeptHierarchy")
  headId      String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  employees Employee[]
  doctors   Doctor[]
  assets    Asset[]

  @@map("departments")
}

// ─── PATIENTS ─────────────────────────────────────────────────────────────────

model Patient {
  id                    String     @id @default(cuid())
  mrn                   String     @unique
  firstName             String
  lastName              String
  dateOfBirth           DateTime   @db.Date
  gender                Gender
  nationality           String?
  nationalId            String?
  phone                 String
  email                 String?
  address               String?
  photo                 String?
  bloodType             BloodType?
  allergies             Json     @default("[]")
  chronicConditions     Json     @default("[]")
  emergencyContactName  String?
  emergencyContactPhone String?
  insuranceProvider     String?
  insurancePolicyNo     String?
  insuranceCoverageType String?
  insuranceExpiry       DateTime?
  notes                 String?
  isActive              Boolean    @default(true)
  mergedIntoId          String?
  lastVisit             DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  appointments    Appointment[]
  consultations   Consultation[]
  invoices        Invoice[]
  labOrders       LabOrder[]
  radiologyOrders RadiologyOrder[]
  consentForms    ConsentForm[]
  documents       PatientDocument[]

  @@map("patients")
}

// ─── DOCTORS ─────────────────────────────────────────────────────────────────

model Doctor {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  specialization  String
  consultationFee Decimal   @db.Decimal(10, 2) @default(0)
  bio             String?
  licenseNumber   String?
  licenseExpiry   DateTime?
  isAvailable     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  availability    DoctorAvailability[]
  appointments    Appointment[]
  consultations   Consultation[]
  labOrders       LabOrder[]
  radiologyOrders RadiologyOrder[]

  @@map("doctors")
}

model DoctorAvailability {
  id          String  @id @default(cuid())
  doctorId    String
  doctor      Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startTime   String
  endTime     String
  slotMinutes Int     @default(30)
  isActive    Boolean @default(true)

  @@map("doctor_availability")
}

// ─── APPOINTMENTS ─────────────────────────────────────────────────────────────

model Appointment {
  id           String            @id @default(cuid())
  patientId    String
  patient      Patient           @relation(fields: [patientId], references: [id])
  doctorId     String
  doctor       Doctor            @relation(fields: [doctorId], references: [id])
  scheduledAt  DateTime
  scheduledEnd DateTime?
  status       AppointmentStatus @default(SCHEDULED)
  type         AppointmentType   @default(CONSULTATION)
  reason       String?
  notes        String?
  room         String?
  isUrgent     Boolean           @default(false)
  isWalkIn     Boolean           @default(false)
  checkedInAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  consultation Consultation?
  invoice      Invoice?

  @@map("appointments")
}

// ─── EMR ──────────────────────────────────────────────────────────────────────

model Consultation {
  id             String      @id @default(cuid())
  appointmentId  String      @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  patientId      String
  patient        Patient     @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         Doctor      @relation(fields: [doctorId], references: [id])
  chiefComplaint String?
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  hpi            String?
  pmh            String?
  examination    String?
  followUpDate   DateTime?
  followUpNotes  String?
  isLocked       Boolean     @default(false)
  lockedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  vitals        Vitals?
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  radiologyOrders RadiologyOrder[]

  @@map("consultations")
}

model Vitals {
  id             String       @id @default(cuid())
  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  bpSystolic     Int?
  bpDiastolic    Int?
  heartRate      Int?
  temperature    Decimal?     @db.Decimal(4, 1)
  weight         Decimal?     @db.Decimal(6, 2)
  height         Decimal?     @db.Decimal(5, 2)
  bmi            Decimal?     @db.Decimal(5, 2)
  spo2           Decimal?     @db.Decimal(5, 2)
  bloodGlucose   Decimal?     @db.Decimal(6, 2)
  respiratoryRate Int?
  recordedById   String?
  recordedAt     DateTime     @default(now())

  @@map("vitals")
}

model Diagnosis {
  id             String        @id @default(cuid())
  consultationId String
  consultation   Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  icdCode        String
  description    String
  type           DiagnosisType @default(PRIMARY)
  notes          String?

  @@map("diagnoses")
}

model Prescription {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  medicationId   String?
  medication     Medication?  @relation(fields: [medicationId], references: [id])
  medicationName String
  dosage         String
  frequency      String
  duration       String
  quantity       Int?
  instructions   String?
  isDispensed    Boolean      @default(false)
  dispensedAt    DateTime?
  dispensedById  String?
  createdAt      DateTime     @default(now())

  @@map("prescriptions")
}

model PatientDocument {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  name         String
  type         String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  notes        String?
  uploadedById String?
  uploadedAt   DateTime @default(now())

  @@map("patient_documents")
}

model ConsentForm {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id])
  formType     String
  formVersion  String
  signedAt     DateTime?
  signatureUrl String?
  witnessId    String?
  isValid      Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@map("consent_forms")
}

// ─── LAB & RADIOLOGY ──────────────────────────────────────────────────────────

model LabOrder {
  id                  String         @id @default(cuid())
  patientId           String
  patient             Patient        @relation(fields: [patientId], references: [id])
  consultationId      String?
  consultation        Consultation?  @relation(fields: [consultationId], references: [id])
  orderedByDoctorId   String
  orderedByDoctor     Doctor         @relation(fields: [orderedByDoctorId], references: [id])
  tests               Json     @default("[]")
  priority            LabPriority    @default(ROUTINE)
  status              LabOrderStatus @default(PENDING_COLLECTION)
  specimenType        String?
  specimenCollected   Boolean        @default(false)
  collectedAt         DateTime?
  collectedById       String?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  results LabResult[]

  @@map("lab_orders")
}

model LabResult {
  id             String   @id @default(cuid())
  labOrderId     String
  labOrder       LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  testName       String
  value          String
  unit           String?
  referenceRange String?
  isAbnormal     Boolean  @default(false)
  isCritical     Boolean  @default(false)
  enteredById    String?
  validatedById  String?
  validatedAt    DateTime?
  recordedAt     DateTime @default(now())

  @@map("lab_results")
}

model RadiologyOrder {
  id                String        @id @default(cuid())
  patientId         String
  patient           Patient       @relation(fields: [patientId], references: [id])
  consultationId    String?
  consultation      Consultation? @relation(fields: [consultationId], references: [id])
  orderedByDoctorId String
  orderedByDoctor   Doctor        @relation(fields: [orderedByDoctorId], references: [id])
  modality          String
  study             String
  bodyPart          String?
  priority          LabPriority   @default(ROUTINE)
  status            String        @default("PENDING")
  clinicalInfo      String?
  scheduledAt       DateTime?
  performedAt       DateTime?
  reportedById      String?
  report            String?
  imageUrls         Json     @default("[]")
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("radiology_orders")
}

// ─── BILLING ──────────────────────────────────────────────────────────────────

model Invoice {
  id               String        @id @default(cuid())
  invoiceNo        String        @unique
  patientId        String
  patient          Patient       @relation(fields: [patientId], references: [id])
  appointmentId    String?       @unique
  appointment      Appointment?  @relation(fields: [appointmentId], references: [id])
  dueDate          DateTime?     @db.Date
  subtotal         Decimal       @db.Decimal(12, 2)
  discountAmount   Decimal       @db.Decimal(12, 2) @default(0)
  discountRate     Decimal?      @db.Decimal(5, 2)
  taxRate          Decimal?      @db.Decimal(5, 2)
  taxAmount        Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount      Decimal       @db.Decimal(12, 2)
  paidAmount       Decimal       @db.Decimal(12, 2) @default(0)
  balance          Decimal       @db.Decimal(12, 2)
  status           InvoiceStatus @default(PENDING)
  insuranceClaim   Boolean       @default(false)
  insuranceProvider String?
  insurancePolicyNo String?
  notes            String?
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  category    String?
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @db.Decimal(5, 2) @default(0)
  totalPrice  Decimal @db.Decimal(12, 2)
  serviceCode String?

  @@map("invoice_items")
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(CASH)
  referenceNo  String?
  notes        String?
  recordedById String?
  recordedBy   User?         @relation(fields: [recordedById], references: [id])
  paidAt       DateTime      @default(now())

  @@map("payments")
}

// ─── PHARMACY & INVENTORY ─────────────────────────────────────────────────────

model Medication {
  id                   String   @id @default(cuid())
  genericName          String
  brandName            String?
  category             String
  unit                 String
  barcode              String?  @unique
  stockQuantity        Int      @default(0)
  minStockLevel        Int      @default(0)
  reorderLevel         Int      @default(0)
  unitCost             Decimal  @db.Decimal(12, 2) @default(0)
  sellingPrice         Decimal  @db.Decimal(12, 2) @default(0)
  location             String?
  isControlled         Boolean  @default(false)
  requiresPrescription Boolean  @default(true)
  isActive             Boolean  @default(true)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  batches        MedicationBatch[]
  prescriptions  Prescription[]
  stockMovements StockMovement[]
  poItems        POItem[]

  @@map("medications")
}

model MedicationBatch {
  id           String     @id @default(cuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id])
  batchNumber  String
  quantity     Int
  expiryDate   DateTime
  receivedDate DateTime   @default(now())
  receivedById String?
  unitCost     Decimal    @db.Decimal(12, 2)
  notes        String?

  @@map("medication_batches")
}

model StockMovement {
  id            String     @id @default(cuid())
  medicationId  String
  medication    Medication @relation(fields: [medicationId], references: [id])
  type          String
  quantity      Int
  previousQty   Int        @default(0)
  newQty        Int        @default(0)
  reason        String?
  referenceId   String?
  notes         String?
  performedById String?
  performedBy   User?      @relation(fields: [performedById], references: [id])
  createdAt     DateTime   @default(now())

  @@map("stock_movements")
}

// ─── PURCHASING ───────────────────────────────────────────────────────────────

model Vendor {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  taxId         String?
  paymentTerms  String?
  bankDetails   String?
  rating        Int?     @default(0)
  isPreferred   Boolean  @default(false)
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  @@map("vendors")
}

model PurchaseOrder {
  id               String    @id @default(cuid())
  poNumber         String    @unique
  vendorId         String
  vendor           Vendor    @relation(fields: [vendorId], references: [id])
  date             DateTime  @db.Date
  expectedDelivery DateTime? @db.Date
  status           POStatus  @default(DRAFT)
  subtotal         Decimal   @db.Decimal(12, 2)
  totalAmount      Decimal   @db.Decimal(12, 2)
  notes            String?
  requestedById    String?
  approvedById     String?
  approvedAt       DateTime?
  receivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items POItem[]

  @@map("purchase_orders")
}

model POItem {
  id           String        @id @default(cuid())
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  medicationId String?
  medication   Medication?   @relation(fields: [medicationId], references: [id])
  itemName     String
  quantity     Int
  unitPrice    Decimal       @db.Decimal(12, 2)
  totalPrice   Decimal       @db.Decimal(12, 2)
  receivedQty  Int           @default(0)
  notes        String?

  @@map("po_items")
}

// ─── ACCOUNTING ───────────────────────────────────────────────────────────────

model Expense {
  id            String    @id @default(cuid())
  date          DateTime  @db.Date
  category      String
  description   String
  amount        Decimal   @db.Decimal(12, 2)
  vendorId      String?
  vendor        Vendor?   @relation(fields: [vendorId], references: [id])
  paymentMethod String?
  referenceNo   String?
  receiptUrl    String?
  isRecurring   Boolean   @default(false)
  status        String    @default("PENDING")
  approvedById  String?
  approvedBy    User?     @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  recordedById  String?
  recordedBy    User?     @relation("ExpenseRecorder", fields: [recordedById], references: [id])
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("expenses")
}

model Asset {
  id                 String             @id @default(cuid())
  name               String
  assetCode          String?            @unique
  category           String
  serialNumber       String?
  departmentId       String?
  department         Department?        @relation(fields: [departmentId], references: [id])
  purchaseDate       DateTime?          @db.Date
  purchasePrice      Decimal?           @db.Decimal(12, 2)
  currentValue       Decimal?           @db.Decimal(12, 2)
  location           String?
  assignedToId       String?
  warrantyExpiry     DateTime?          @db.Date
  status             AssetStatus        @default(ACTIVE)
  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)
  usefulLifeYears    Int                @default(5)
  salvageValue       Decimal            @db.Decimal(12, 2) @default(0)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  maintenanceLogs AssetMaintenance[]

  @@map("assets")
}

model AssetMaintenance {
  id          String    @id @default(cuid())
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id])
  type        String
  description String
  cost        Decimal?  @db.Decimal(12, 2)
  performedBy String?
  scheduledDate DateTime
  performedAt  DateTime?
  nextDue     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  @@map("asset_maintenance")
}

// ─── HUMAN RESOURCES ─────────────────────────────────────────────────────────

model Employee {
  id                 String         @id @default(cuid())
  empCode            String         @unique
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id])
  departmentId       String
  department         Department     @relation(fields: [departmentId], references: [id])
  jobTitle           String
  employmentType     EmploymentType @default(FULL_TIME)
  status             EmployeeStatus @default(ACTIVE)
  basicSalary        Decimal        @db.Decimal(12, 2)
  housingAllowance   Decimal        @db.Decimal(12, 2) @default(0)
  transportAllowance Decimal        @db.Decimal(12, 2) @default(0)
  medicalAllowance   Decimal        @db.Decimal(12, 2) @default(0)
  hireDate           DateTime       @db.Date
  endDate            DateTime?      @db.Date
  bankName           String?
  bankAccount        String?
  annualLeaveBalance Int            @default(21)
  sickLeaveBalance   Int            @default(14)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  attendance     Attendance[]
  leaveRequests  LeaveRequest[]
  payrollRecords Payroll[]

  @@map("employees")
}

model Attendance {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  date         DateTime  @db.Date
  checkIn      DateTime?
  checkOut     DateTime?
  status       String    @default("PRESENT")
  overtimeHrs  Decimal?  @db.Decimal(5, 2)
  notes        String?
  enteredById  String?
  isManual     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@unique([employeeId, date])
  @@map("attendance")
}

model LeaveRequest {
  id             String      @id @default(cuid())
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id])
  type           LeaveType
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  days           Int
  reason         String?
  status         LeaveStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("leave_requests")
}

model Payroll {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  month         Int
  year          Int
  basicSalary   Decimal  @db.Decimal(12, 2)
  allowances    Decimal  @db.Decimal(12, 2) @default(0)
  bonus         Decimal  @db.Decimal(12, 2) @default(0)
  overtimePay   Decimal  @db.Decimal(12, 2) @default(0)
  deductions    Decimal  @db.Decimal(12, 2) @default(0)
  taxDeduction  Decimal  @db.Decimal(12, 2) @default(0)
  grossSalary   Decimal  @db.Decimal(12, 2)
  netSalary     Decimal  @db.Decimal(12, 2)
  status        String   @default("PENDING")
  processedById String?
  processedAt   DateTime?
  payslipUrl    String?
  notes         String?
  createdAt     DateTime @default(now())

  @@unique([employeeId, month, year])
  @@map("payroll")
}

// ─── AUDIT & NOTIFICATIONS ────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  module     String
  entityId   String?
  entityType String?
  oldValues  String?  @db.Text
  newValues  String?  @db.Text
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([timestamp])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── INSURANCE ────────────────────────────────────────────────────────────────

model InsuranceProvider {
  id               String   @id @default(cuid())
  name             String
  code             String   @unique
  contactPhone     String?
  contactEmail     String?
  approvedServices Json     @default("[]")
  coPay            Decimal? @db.Decimal(5, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@map("insurance_providers")
}

model InsuranceClaim {
  id              String    @id @default(cuid())
  invoiceId       String
  providerId      String
  claimNumber     String?
  submittedAt     DateTime?
  amount          Decimal   @db.Decimal(12, 2)
  approvedAmount  Decimal?  @db.Decimal(12, 2)
  status          String    @default("PENDING")
  rejectionReason String?
  resubmittedAt   DateTime?
  paidAt          DateTime?
  documents       Json     @default("[]")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("insurance_claims")
}
