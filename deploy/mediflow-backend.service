[Unit]
Description=MediFlow FastAPI Backend
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=mediflow
Group=mediflow
WorkingDirectory=/opt/mediflow/backend
EnvironmentFile=/opt/mediflow/backend/.env
ExecStart=/opt/mediflow/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mediflow-backend

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/mediflow/backend

[Install]
WantedBy=multi-user.target
