# ── Database ──────────────────────────────────────────────────────────────────
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://mediflow:STRONG_PASSWORD@localhost:3306/mediflow_db

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET

# ── Encryption (2FA secrets, API keys) ───────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=https://yourdomain.com

# ── Cookies ───────────────────────────────────────────────────────────────────
# Set to true in production (requires HTTPS)
COOKIE_SECURE=true

# ── Redis (optional — for distributed settings cache) ────────────────────────
# REDIS_URL=redis://localhost:6379/0
